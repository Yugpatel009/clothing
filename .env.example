# Copy to .env and change ADMIN_PASSWORD before using /admin.
PORT=3000
ADMIN_USER=traceip-admin
ADMIN_PASSWORD=User@1234

# Keep logs for a short, defined period (1–90 days).
LOG_RETENTION_DAYS=7

# Leave false unless the app is deployed behind a reverse proxy you control
# and have explicitly configured to sanitize forwarded-IP headers.
TRUST_PROXY=false

# Set true only when HTTPS is terminated before this app in production.
NODE_ENV=development
